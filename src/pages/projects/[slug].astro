---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCover from '../../components/ProjectCover.astro';
import ProjectBadges from '../../components/ProjectBadges.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length], prev: projects[(i - 1 + projects.length) % projects.length] },
  }));
}

const { project, next, prev } = Astro.props;
const { data } = project;
const { Content } = await render(project);
---

<Base title={`${data.title} — Roey Deljou`} description={data.summary}>
  <article class="pt-28 pb-16 sm:pt-32">
    <div class="container-x">
      <a href="/#projects" class="no-print inline-flex items-center gap-1.5 text-sm text-muted hover:text-fg">
        <Icon name="arrowLeft" size={15} /> All projects
      </a>

      <header class="mt-8 grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:items-end lg:gap-12">
        <div>
          <ProjectBadges data={data} />
          <h1 class="mt-5 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{data.title}</h1>
          <p class="mt-5 text-lg leading-relaxed text-muted">{data.summary}</p>

          <div class="mt-7 flex flex-wrap gap-3">
            {
              data.demo && (
                <a href={data.demo} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-accent to-accent-2 px-5 py-2.5 text-sm font-semibold text-accent-fg shadow-lg shadow-accent/25">
                  Visit live app <Icon name="external" size={15} />
                </a>
              )
            }
            {
              data.repo && (
                <a href={data.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-line bg-elev px-5 py-2.5 text-sm font-semibold hover:border-accent">
                  <Icon name="github" size={16} /> View source
                </a>
              )
            }
          </div>
        </div>

        <dl class="card grid grid-cols-2 gap-x-6 gap-y-5 p-6 text-sm">
          <div class="col-span-2">
            <dt class="text-xs tracking-wide text-subtle uppercase">Role</dt>
            <dd class="mt-1 font-medium">{data.role}</dd>
          </div>
          <div>
            <dt class="text-xs tracking-wide text-subtle uppercase">Timeline</dt>
            <dd class="mt-1 font-medium">{data.period}</dd>
          </div>
          {
            data.company && (
              <div>
                <dt class="text-xs tracking-wide text-subtle uppercase">Company</dt>
                <dd class="mt-1 font-medium">{data.company}</dd>
              </div>
            )
          }
          {
            data.collaborators.length > 0 && (
              <div>
                <dt class="text-xs tracking-wide text-subtle uppercase">With</dt>
                <dd class="mt-1 font-medium">
                  {data.collaborators.map((c, i) => (
                    <>
                      {i > 0 && ', '}
                      {c.url ? (
                        <a href={c.url} target="_blank" rel="noopener" class="text-accent hover:underline">{c.name}</a>
                      ) : (
                        c.name
                      )}
                    </>
                  ))}
                </dd>
              </div>
            )
          }
          <div class="col-span-2">
            <dt class="mb-2 text-xs tracking-wide text-subtle uppercase">Stack</dt>
            <dd class="flex flex-wrap gap-1.5">
              {data.tech.map((t) => <span class="chip">{t}</span>)}
            </dd>
          </div>
        </dl>
      </header>

      <ProjectCover title={data.title} hue={data.hue} mark={data.mark} image={data.image} size="lg" class="no-print mt-12 aspect-[16/7] rounded-3xl border border-line" />

      {
        data.metrics.length > 0 && (
          <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
            {data.metrics.map((m) => (
              <li class="card p-5">
                <div class="text-gradient text-3xl font-semibold tracking-tight">{m.value}</div>
                <div class="mt-1.5 text-sm text-muted">{m.label}</div>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-14 grid gap-12 lg:grid-cols-[1fr_17rem]">
        <div class="prose prose-project max-w-none prose-headings:tracking-tight prose-h2:mt-12 prose-h2:text-2xl first:prose-h2:mt-0 prose-a:no-underline hover:prose-a:underline">
          <Content />
        </div>

        {
          data.highlights.length > 0 && (
            <aside class="lg:sticky lg:top-24 lg:self-start">
              <div class="card p-6">
                <h2 class="mb-4 text-sm font-semibold">Key highlights</h2>
                <ul class="space-y-3">
                  {data.highlights.map((h) => (
                    <li class="flex gap-2.5 text-sm text-muted">
                      <Icon name="check" size={16} class="mt-0.5 shrink-0 text-accent" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )
        }
      </div>

      <nav class="no-print mt-20 grid gap-4 border-t border-line pt-10 sm:grid-cols-2" aria-label="More projects">
        <a href={`/projects/${prev.id}/`} class="card group p-5 transition-colors hover:border-accent/50">
          <span class="flex items-center gap-1.5 text-xs text-subtle"><Icon name="arrowLeft" size={13} /> Previous</span>
          <span class="mt-1 block font-semibold group-hover:text-accent">{prev.data.title}</span>
        </a>
        <a href={`/projects/${next.id}/`} class="card group p-5 text-right transition-colors hover:border-accent/50">
          <span class="flex items-center justify-end gap-1.5 text-xs text-subtle">Next <Icon name="arrowRight" size={13} /></span>
          <span class="mt-1 block font-semibold group-hover:text-accent">{next.data.title}</span>
        </a>
      </nav>
    </div>
  </article>
</Base>
