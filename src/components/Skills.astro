---
/**
 * SKILLS — desktop: an orbital system (AI-native core, skill rings orbiting it).
 * Mobile: three marquee rows moving in alternating directions.
 * A plain grouped list is always present for screen readers.
 */
import Icon from './Icon.astro';
import { skills } from '../data/skills';

// Orbit rings, inner → outer. Hand-picked so chips stay evenly spaced; the full list is in the cards below.
const ringItems = [
  { radius: 0.4, speed: 50, items: ['Claude Code', 'Cursor', 'Codex', 'Multi-agent', 'LLM APIs'] },
  { radius: 0.66, speed: 80, items: ['C#', 'Unity 3D', 'TypeScript', 'Python', 'Java', 'Simulation', 'Gameplay systems', 'AI behaviours'] },
  { radius: 0.94, speed: 120, items: ['React', 'Next.js', 'Node.js', 'Fastify', 'Socket.IO', 'FastAPI', 'PostgreSQL', 'Prisma', 'Redis', 'OpenCV', 'Vercel', 'GitHub Actions'] },
];
const all = skills.flatMap((g) => g.items);
const rows = [all.filter((_, i) => i % 3 === 0), all.filter((_, i) => i % 3 === 1), all.filter((_, i) => i % 3 === 2)];
---

<section id="skills" class="relative overflow-hidden py-20 sm:py-28">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-3 font-mono text-xs font-medium tracking-[0.2em] text-accent uppercase">Skills</p>
      <h2 class="text-4xl font-semibold tracking-tighter sm:text-6xl" data-split>The toolkit.</h2>
      <p class="reveal mt-5 text-base leading-relaxed text-muted sm:text-lg">
        Deep in Unity and C#, fluent across TypeScript and Python, and fast because AI agents sit at the core of how I engineer.
      </p>
    </div>
  </div>

  <!-- Desktop orbit -->
  <div class="orbit reveal" aria-hidden="true">
    <div class="orbit-core">
      <span class="orbit-core-glow"></span>
      <Icon name="sparkles" size={30} />
      <span class="mt-2 text-sm font-semibold">AI-native</span>
      <span class="font-mono text-[0.6rem] tracking-[0.18em] text-subtle uppercase">core</span>
    </div>
    {
      ringItems.map((ring, ri) => (
        <div class="orbit-ring" style={`--r:${ring.radius};--speed:${ring.speed}s;--dir:${ri % 2 ? 'reverse' : 'normal'};--cdir:${ri % 2 ? 'normal' : 'reverse'}`}>
          {ring.items.map((s, i) => (
            <span class="orbit-item" style={`--a:${(360 / ring.items.length) * i}deg`}>
              <span class="orbit-chip">{s}</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>

  <!-- Mobile marquees -->
  <div class="skill-marquees mt-12 space-y-3" aria-hidden="true">
    {
      rows.map((row, i) => (
        <div class={`marquee ${i % 2 ? 'marquee-reverse' : ''}`} style={`--marquee-speed:${38 + i * 8}s`}>
          {[0, 1].map(() => (
            <div class="marquee-track !gap-2.5 !pr-2.5">
              {row.map((s) => (
                <span class="chip !px-3.5 !py-1.5 !text-sm">{s}</span>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <!-- Grouped list: readable on every device and for screen readers -->
  <div class="container-x mt-14">
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        skills.map((g) => (
          <div class="card reveal p-5" data-tilt="5">
            <div class="mb-3 flex items-center gap-2.5">
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-accent/10 text-accent">
                <Icon name={g.icon} size={16} />
              </span>
              <h3 class="text-sm font-semibold">{g.category}</h3>
            </div>
            <p class="text-sm leading-relaxed text-muted">{g.items.join(' · ')}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .orbit { display: none; }
  @media (width >= 1024px) {
    .skill-marquees { display: none; }
    .orbit {
      --size: min(50rem, 82vw);
      display: block;
      position: relative;
      width: var(--size);
      height: var(--size);
      margin: 3rem auto 0;
    }
  }
  .orbit-core {
    position: absolute; left: 50%; top: 50%;
    width: 9.5rem; height: 9.5rem; margin: -4.75rem 0 0 -4.75rem;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    border-radius: 999px;
    background: var(--bg-elev);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
    z-index: 2;
  }
  .orbit-core > span:not(.orbit-core-glow) { color: var(--fg); }
  .orbit-core-glow {
    position: absolute; inset: -40%;
    border-radius: 999px;
    background: radial-gradient(circle, var(--glow), transparent 65%);
    z-index: -1;
    animation: pulse 3.5s ease-in-out infinite;
  }
  @keyframes pulse { 50% { transform: scale(1.15); opacity: 0.7; } }
  .orbit-ring {
    position: absolute; left: 50%; top: 50%;
    width: calc(var(--size) * var(--r)); height: calc(var(--size) * var(--r));
    margin: calc(var(--size) * var(--r) / -2) 0 0 calc(var(--size) * var(--r) / -2);
    border: 1px dashed var(--border);
    border-radius: 999px;
    animation: spin var(--speed) linear infinite;
    animation-direction: var(--dir);
  }
  .orbit-item {
    position: absolute; left: 50%; top: 50%;
    transform: rotate(var(--a)) translate(calc(var(--size) * var(--r) / 2)) rotate(calc(var(--a) * -1));
  }
  .orbit-chip {
    display: inline-block;
    transform: translate(-50%, -50%);
    white-space: nowrap;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: var(--fg-muted);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.78rem;
    font-weight: 500;
    animation: spin var(--speed) linear infinite;
    animation-direction: var(--cdir);
    transition: color 0.2s, border-color 0.2s;
  }
  .orbit:hover .orbit-ring, .orbit:hover .orbit-chip { animation-play-state: paused; }
  .orbit-chip:hover { color: var(--fg); border-color: var(--accent); }
  @keyframes spin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) {
    .orbit-ring, .orbit-chip, .orbit-core-glow { animation: none; }
  }
</style>
