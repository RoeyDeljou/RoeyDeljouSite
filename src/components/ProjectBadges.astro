---
import Icon from './Icon.astro';
import { categoryLabel, type Project } from '../lib/projects';

interface Props {
  data: Project['data'];
}
const { data } = Astro.props;
---

<div class="flex flex-wrap items-center gap-1.5">
  <span class="chip !border-accent/30 !bg-accent/10 !text-accent">
    {data.category === 'work' ? <Icon name="briefcase" size={12} /> : data.category === 'collab' ? <Icon name="users" size={12} /> : null}
    {data.category === 'work' && data.company ? data.company : categoryLabel[data.category]}
  </span>
  {data.platform && <span class="chip">{data.platform}</span>}
  {data.demo && (
    <span class="chip !text-emerald-600 dark:!text-emerald-400">
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" /> Live
    </span>
  )}
  {(data.repoPrivate || data.category === 'work') && !data.repo && (
    <span class="chip">
      <Icon name="lock" size={11} /> {data.category === 'work' ? 'Confidential' : 'Private repo'}
    </span>
  )}
</div>
