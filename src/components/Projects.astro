---
import SectionHeading from './SectionHeading.astro';
import ProjectCover from './ProjectCover.astro';
import ProjectBadges from './ProjectBadges.astro';
import Icon from './Icon.astro';
import { getProjects, categoryLabel } from '../lib/projects';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const categories = ['work', 'client', 'personal', 'collab'] as const;
const counts = Object.fromEntries(categories.map((c) => [c, rest.filter((p) => p.data.category === c).length]));
---

<section id="projects" class="py-20 sm:py-28">
  <div class="container-x">
    <SectionHeading
      eyebrow="Selected work"
      title="Projects I’m proud of."
      subtitle="From real-time combat-training simulators to production PWAs and autonomous AI pipelines. Each one links to a full case study: the problem, the architecture, and the decisions behind it."
    />

    <!-- Featured -->
    <div class="space-y-6 sm:space-y-8">
      {
        featured.map((p, i) => (
          <article class="card group reveal overflow-hidden transition-colors hover:border-accent/50">
            <a href={`/projects/${p.id}/`} class={`grid md:grid-cols-2 ${i % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>
              <ProjectCover title={p.data.title} hue={p.data.hue} mark={p.data.mark} image={p.data.image} class="aspect-[16/10] md:aspect-auto md:min-h-[22rem]" />
              <div class="flex flex-col p-6 sm:p-8">
                <ProjectBadges data={p.data} />
                <h3 class="mt-4 text-2xl font-semibold tracking-tight sm:text-[1.7rem]">{p.data.title}</h3>
                <p class="mt-1 text-xs text-subtle">
                  {p.data.role} · {p.data.period}
                </p>
                <p class="mt-4 text-sm leading-relaxed text-muted sm:text-base">{p.data.summary}</p>
                {p.data.highlights.length > 0 && (
                  <ul class="mt-5 space-y-2">
                    {p.data.highlights.slice(0, 4).map((h) => (
                      <li class="flex gap-2.5 text-sm text-muted">
                        <Icon name="check" size={16} class="mt-0.5 shrink-0 text-accent" />
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <ul class="mt-6 flex flex-wrap gap-1.5">
                  {p.data.tech.slice(0, 7).map((t) => (
                    <li class="chip">{t}</li>
                  ))}
                  {p.data.tech.length > 7 && <li class="chip">+{p.data.tech.length - 7}</li>}
                </ul>
                <span class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-accent">
                  Read case study <Icon name="arrowRight" size={15} class="transition-transform group-hover:translate-x-1" />
                </span>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    <!-- More projects -->
    <div class="mt-20">
      <div class="reveal mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">More projects</h3>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter projects">
          <button type="button" class="filter-btn active" data-filter="all">All <span>{rest.length}</span></button>
          {
            categories
              .filter((c) => counts[c] > 0)
              .map((c) => (
                <button type="button" class="filter-btn" data-filter={c}>
                  {categoryLabel[c]} <span>{counts[c]}</span>
                </button>
              ))
          }
        </div>
      </div>

      <ul id="project-grid" class="grid gap-4 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {
          rest.map((p) => (
            <li data-category={p.data.category} class="reveal">
              <a href={`/projects/${p.id}/`} class="card group flex h-full flex-col overflow-hidden transition-all hover:-translate-y-1 hover:border-accent/50">
                <ProjectCover title={p.data.title} hue={p.data.hue} mark={p.data.mark} image={p.data.image} class="aspect-[16/8]" />
                <div class="flex flex-1 flex-col p-5">
                  <ProjectBadges data={p.data} />
                  <h4 class="mt-3 text-lg font-semibold tracking-tight">{p.data.title}</h4>
                  <p class="mt-0.5 text-xs text-subtle">{p.data.period}</p>
                  <p class="mt-3 line-clamp-4 text-sm leading-relaxed text-muted">{p.data.summary}</p>
                  <ul class="mt-4 flex flex-wrap gap-1.5">
                    {p.data.tech.slice(0, 4).map((t) => (
                      <li class="chip">{t}</li>
                    ))}
                  </ul>
                  <span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-medium text-accent">
                    Details <Icon name="arrowUpRight" size={14} class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition: all 0.2s;
  }
  .filter-btn span {
    font-size: 0.7rem;
    color: var(--fg-subtle);
  }
  .filter-btn:hover { color: var(--fg); }
  .filter-btn.active {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }
  .filter-btn.active span { color: var(--bg); opacity: 0.7; }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLLIElement>('#project-grid > li');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const f = b.dataset.filter;
      buttons.forEach((x) => {
        x.classList.toggle('active', x === b);
        x.setAttribute('aria-pressed', String(x === b));
      });
      items.forEach((li) => {
        li.hidden = f !== 'all' && li.dataset.category !== f;
      });
    }),
  );
</script>
