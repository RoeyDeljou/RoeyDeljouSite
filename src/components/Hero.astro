---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const roles = ['real-time simulations', 'games in Unity', 'AI agent pipelines', 'production platforms', 'multiplayer worlds'];
---

<section id="top" class="hero relative isolate flex min-h-[100svh] items-center overflow-hidden">
  <canvas id="hero-canvas" class="absolute inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
  <div class="hero-vignette absolute inset-0 -z-10" aria-hidden="true"></div>

  <!-- Engine-viewport HUD -->
  <div class="hud pointer-events-none absolute inset-4 hidden sm:block sm:inset-6" aria-hidden="true">
    <span class="hud-corner tl"></span><span class="hud-corner tr"></span><span class="hud-corner bl"></span><span class="hud-corner br"></span>
    <div class="hud-text absolute top-16 right-3 text-right font-mono">
      <div>VIEWPORT · PERSPECTIVE</div>
      <div><span id="hud-fps">60</span> FPS · 5.2K PARTICLES</div>
    </div>
    <div class="hud-text absolute bottom-3 left-3 font-mono">
      CURSOR <span id="hud-xy">0.00, 0.00</span>
    </div>
    <div class="hud-text absolute right-3 bottom-3 font-mono">
      RENDERING › <span id="hero-shape" class="text-accent-2">name.render()</span>
    </div>
  </div>

  <div class="container-x relative pt-24 pb-28">
    <div class="max-w-3xl">
      <p class="hero-in mb-6 flex items-center gap-3 font-mono text-xs tracking-[0.18em] text-muted uppercase">
        <span class="inline-block h-px w-10 bg-gradient-to-r from-accent to-accent-2"></span>
        Software Engineer · {profile.location}
      </p>

      <h1 class="hero-title font-semibold tracking-tighter">
        <span class="hero-line block"><span class="hero-in block">Roey</span></span>
        <span class="hero-line block"><span class="hero-in text-outline block">Deljou</span></span>
      </h1>

      <p class="hero-in mt-6 font-mono text-base text-muted sm:text-lg">
        <span class="text-subtle">&gt;</span> I build <span id="hero-role" class="text-gradient font-semibold" data-roles={JSON.stringify(roles)}>{roles[0]}</span><span class="hero-caret"></span>
      </p>

      <p class="hero-in mt-5 max-w-xl text-base leading-relaxed text-muted sm:text-lg">
        {profile.tagline}
      </p>

      <div class="hero-in mt-9 flex flex-wrap items-center gap-3">
        <a href="#projects" data-magnetic class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-accent to-accent-2 px-6 py-3.5 text-sm font-semibold text-accent-fg shadow-lg shadow-accent/30">
          Explore my work <Icon name="arrowRight" size={16} />
        </a>
        <a href={profile.resumePdf} download data-magnetic class="inline-flex items-center gap-2 rounded-full border border-line bg-elev/70 px-6 py-3.5 text-sm font-semibold backdrop-blur">
          <Icon name="download" size={16} /> Download CV
        </a>
        {
          profile.openToWork && (
            <span class="ml-1 inline-flex items-center gap-2 text-xs font-medium text-muted">
              <span class="relative flex h-2 w-2">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
                <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
              </span>
              {profile.openToWorkLabel}
            </span>
          )
        }
      </div>
    </div>
  </div>

  <a href="#about" class="scroll-cue absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-[0.65rem] tracking-[0.25em] text-subtle uppercase md:flex" aria-label="Scroll to content">
    <span class="scroll-mouse"><span></span></span>
    Scroll
  </a>
</section>

<style>
  .hero-title { font-size: clamp(3.6rem, 13vw, 10.5rem); line-height: 0.88; }
  .hero-line { overflow: hidden; padding-bottom: 0.06em; }
  .hero-vignette {
    background:
      linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 70%, transparent) 38%, transparent 70%),
      linear-gradient(0deg, var(--bg) 0%, transparent 25%);
  }
  @media (max-width: 1023px) {
    .hero-vignette { background: linear-gradient(0deg, var(--bg) 10%, color-mix(in srgb, var(--bg) 35%, transparent) 55%, transparent 100%); }
    #hero-canvas { opacity: 0.7; }
  }
  .hero-caret {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 3px;
    vertical-align: -0.18em;
    background: var(--accent-2);
    animation: caret 1s steps(1) infinite;
  }
  @keyframes caret { 50% { opacity: 0; } }
  .hud-corner { position: absolute; width: 22px; height: 22px; border-color: color-mix(in srgb, var(--fg) 30%, transparent); border-style: solid; border-width: 0; }
  .hud-corner.tl { top: 3.5rem; left: 0; border-top-width: 1.5px; border-left-width: 1.5px; }
  .hud-corner.tr { top: 3.5rem; right: 0; border-top-width: 1.5px; border-right-width: 1.5px; }
  .hud-corner.bl { bottom: 0; left: 0; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .hud-corner.br { bottom: 0; right: 0; border-bottom-width: 1.5px; border-right-width: 1.5px; }
  .hud-text { font-size: 0.62rem; letter-spacing: 0.16em; line-height: 1.8; color: var(--fg-subtle); }
  .scroll-mouse { width: 20px; height: 32px; border: 1.5px solid var(--fg-subtle); border-radius: 12px; display: grid; justify-items: center; padding-top: 6px; }
  .scroll-mouse span { width: 2px; height: 7px; border-radius: 2px; background: var(--accent-2); animation: wheel 1.6s ease-in-out infinite; }
  @keyframes wheel { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(9px); opacity: 0; } 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-caret, .scroll-mouse span { animation: none; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;

  // WebGL scene — loaded as its own chunk so text paints first
  const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 1200 }) : setTimeout(fn, 300));
  const startScene = () =>
    new Promise<void>((res) => idle(res)).then(() => import('../scripts/hero-scene')).then(({ initHeroScene }) => initHeroScene(canvas, document.getElementById('hero-shape'))).catch(() => {});

  // Entrance
  const enter = () => {
    if (reduced) return;
    gsap.from('.hero-in', { yPercent: 110, opacity: 0, duration: 1.1, ease: 'expo.out', stagger: 0.08 });
    gsap.from('.hud', { opacity: 0, duration: 1.2, delay: 0.4 });
  };

  startScene(); // particles start flying in behind the intro
  if (document.documentElement.classList.contains('intro-active')) {
    window.addEventListener('intro:done', enter, { once: true });
  } else {
    enter();
  }

  // Role scramble
  const roleEl = document.getElementById('hero-role')!;
  const roles: string[] = JSON.parse(roleEl.dataset.roles!);
  const glyphs = '!<>-_\\/[]{}=+*^?#01';
  let idx = 0;
  const scrambleTo = (text: string) => {
    const from = roleEl.textContent ?? '';
    const len = Math.max(from.length, text.length);
    let frame = 0;
    const total = 26;
    const step = () => {
      let out = '';
      for (let i = 0; i < len; i++) {
        const revealAt = (i / len) * total * 0.7 + 6;
        if (frame >= revealAt) out += text[i] ?? '';
        else if (frame >= revealAt - 8) out += glyphs[Math.floor(Math.random() * glyphs.length)];
        else out += from[i] ?? '';
      }
      roleEl.textContent = out;
      if (frame++ < total) requestAnimationFrame(step);
      else roleEl.textContent = text;
    };
    step();
  };
  if (!reduced) setInterval(() => { idx = (idx + 1) % roles.length; scrambleTo(roles[idx]); }, 2800);

  // HUD readouts
  const xy = document.getElementById('hud-xy');
  const fpsEl = document.getElementById('hud-fps');
  window.addEventListener('pointermove', (e) => {
    if (xy) xy.textContent = `${(e.clientX / window.innerWidth * 2 - 1).toFixed(2)}, ${(-(e.clientY / window.innerHeight) * 2 + 1).toFixed(2)}`;
  }, { passive: true });
  if (fpsEl && !reduced) {
    let frames = 0, last = performance.now();
    const loop = (t: number) => {
      frames++;
      if (t - last >= 1000) { fpsEl.textContent = String(Math.min(120, frames)); frames = 0; last = t; }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>
