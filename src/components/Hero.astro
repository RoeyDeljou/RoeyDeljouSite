---
import Icon from './Icon.astro';
import { profile } from '../data/profile';

const focus = ['Unity & C#', 'Real-time simulation', 'TypeScript full-stack', 'AI-native engineering'];
---

<section class="relative isolate overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
  <div class="hero-bg -z-10"></div>
  <div class="hero-glow -z-10"></div>

  <div class="container-x grid items-center gap-14 lg:grid-cols-[1.35fr_1fr]">
    <div class="max-w-3xl">
      {
        profile.openToWork && (
          <a href="#contact" class="reveal mb-7 inline-flex items-center gap-2 rounded-full border border-line bg-elev/70 px-3.5 py-1.5 text-xs font-medium text-muted backdrop-blur transition-colors hover:text-fg">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500" />
            </span>
            {profile.openToWorkLabel}
            <Icon name="arrowRight" size={13} />
          </a>
        )
      }

      <h1 class="reveal text-[2.6rem] leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-7xl">
        Hi, I’m {profile.firstName}.<br />
        <span class="text-gradient">I build software that moves.</span>
      </h1>

      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
        {profile.tagline}
      </p>

      <ul class="reveal mt-7 flex flex-wrap gap-2" aria-label="Focus areas">
        {focus.map((f) => <li class="chip">{f}</li>)}
      </ul>

      <div class="reveal mt-9 flex flex-wrap items-center gap-3">
        <a href="#projects" class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-accent to-accent-2 px-6 py-3 text-sm font-semibold text-accent-fg shadow-lg shadow-accent/25 transition-transform hover:-translate-y-0.5">
          View my work <Icon name="arrowRight" size={16} />
        </a>
        <a href={profile.resumePdf} download class="inline-flex items-center gap-2 rounded-full border border-line bg-elev px-6 py-3 text-sm font-semibold transition-colors hover:border-accent">
          <Icon name="download" size={16} /> Download CV
        </a>
        <div class="ml-1 flex items-center gap-1">
          <a href={profile.socials.github} target="_blank" rel="noopener" class="grid h-11 w-11 place-items-center rounded-full text-muted transition-colors hover:bg-soft hover:text-fg" aria-label="GitHub">
            <Icon name="github" size={20} />
          </a>
          <a href={profile.socials.linkedin} target="_blank" rel="noopener" class="grid h-11 w-11 place-items-center rounded-full text-muted transition-colors hover:bg-soft hover:text-fg" aria-label="LinkedIn">
            <Icon name="linkedin" size={20} />
          </a>
          <a href={`mailto:${profile.email}`} class="grid h-11 w-11 place-items-center rounded-full text-muted transition-colors hover:bg-soft hover:text-fg" aria-label="Email">
            <Icon name="mail" size={20} />
          </a>
        </div>
      </div>
    </div>

    <!-- Code-style profile card (desktop) -->
    <div class="reveal relative hidden lg:block" aria-hidden="true">
      <div class="absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-accent/25 to-accent-2/20 blur-2xl"></div>
      <div class="card relative overflow-hidden !rounded-2xl">
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 font-mono text-xs text-subtle">roey.ts</span>
        </div>
        <pre class="overflow-hidden p-5 font-mono text-[0.8rem] leading-6 text-muted"><code><span class="tk-k">const</span> <span class="tk-v">roey</span> = {'{'}
  role: <span class="tk-s">'Software Engineer'</span>,
  base: <span class="tk-s">'Israel'</span>,
  experience: [
    <span class="tk-s">'Bagira Systems'</span>,   <span class="tk-c">// Unity sims</span>
    <span class="tk-s">'AddForce Gaming'</span>,  <span class="tk-c">// Team lead</span>
    <span class="tk-s">'NFL Health & Safety'</span>,
  ],
  stack: [<span class="tk-s">'C#'</span>, <span class="tk-s">'Unity'</span>, <span class="tk-s">'TypeScript'</span>,
          <span class="tk-s">'Next.js'</span>, <span class="tk-s">'Node'</span>, <span class="tk-s">'Python'</span>],
  superpower: <span class="tk-s">'AI-native engineering'</span>,
  available: <span class="tk-k">true</span>,
{'}'};

<span class="tk-v">roey</span>.<span class="tk-f">ship</span>(<span class="tk-s">'your next product'</span>);<span class="caret"></span></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .tk-k { color: var(--accent); }
  .tk-v { color: var(--fg); font-weight: 600; }
  .tk-s { color: var(--accent-2); }
  .tk-c { color: var(--fg-subtle); font-style: italic; }
  .tk-f { color: #f59e0b; }
  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
</style>
